{
  "name": "agentic-publish",
"version": "0.2.0",
  "description": "Publish and queue social posts through Content Rabbit, Zernio, Ayrshare, Postiz, phone, X, LinkedIn, TikTok, and Instagram with TypeScript, CLI, and MCP.",
  "keywords": [
    "social-publishing",
    "private-repo-c4e6",
    "zernio",
    "ayrshare",
    "x",
    "twitter",
    "linkedin",
    "tiktok",
    "instagram",
    "typescript",
    "cli",
    "mcp",
    "brand-queue",
    "approval"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-publish.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "docs",
    "server.json",
    ".mcp.json",
    "AGENTS.md",
    "RULES.md",
    "SKILL.md",
    "llms.txt",
    "agentic-core.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-publish",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-publish": "./dist/cli.js",
    "agentic-publish-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "^0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}